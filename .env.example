NODE_ENV=development
API_PORT=3001
POSTGRES_DB=defterdar
POSTGRES_USER=defterdar
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://defterdar:replace-with-a-local-password@localhost:5432/defterdar?schema=public
TEST_DATABASE_URL=postgresql://defterdar:replace-with-a-local-password@localhost:5432/defterdar?schema=auth_e2e
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
DEFAULT_CURRENCY=TRY
INVITATION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=defterdar-receipts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=900

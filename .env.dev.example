# DEV worktree template. Copy to /srv/defterdar-dev/.env and replace every
# replace-with-* and <DOMAIN> value. Never reuse STAGING credentials.
DEFTERDAR_ENVIRONMENT=dev
NODE_ENV=development
PORT=3200
API_HOST=127.0.0.1
API_PORT=3201
API_BODY_LIMIT=1mb

COMPOSE_PROJECT_NAME=defterdar-dev
POSTGRES_DB=defterdar_dev
POSTGRES_USER=defterdar_dev
POSTGRES_PASSWORD=replace-with-dev-openssl-rand-hex-32
POSTGRES_PORT=55432
DATABASE_URL=postgresql://defterdar_dev:replace-with-dev-openssl-rand-hex-32@127.0.0.1:55432/defterdar_dev?schema=public
TEST_DATABASE_URL=postgresql://defterdar_dev:replace-with-dev-openssl-rand-hex-32@127.0.0.1:55432/defterdar_dev?schema=auth_e2e

JWT_ACCESS_SECRET=replace-with-dev-openssl-rand-hex-32
JWT_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
DEFAULT_CURRENCY=TRY
INVITATION_TTL_DAYS=7
CORS_ORIGINS=https://dev.<DOMAIN>

# Self-hosted MinIO: keep these equal to the S3 access/secret pair below.
MINIO_ROOT_USER=defterdar-dev
MINIO_ROOT_PASSWORD=replace-with-dev-openssl-rand-hex-32
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=defterdar-dev-receipts
S3_ACCESS_KEY_ID=defterdar-dev
S3_SECRET_ACCESS_KEY=replace-with-dev-openssl-rand-hex-32
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=900

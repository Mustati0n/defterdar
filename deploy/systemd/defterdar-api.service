[Unit]
Description=Defterdar NestJS API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=defterdar
Group=defterdar
WorkingDirectory=/srv/defterdar
EnvironmentFile=/srv/defterdar/.env
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/bin
ExecStart=/usr/bin/node /srv/defterdar/apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full

[Install]
WantedBy=multi-user.target

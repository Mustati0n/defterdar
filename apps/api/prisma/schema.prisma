generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LedgerType {
  PERSONAL
  SHARED
}

enum LedgerRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExpenseSplitMethod {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CategoryKind {
  EXPENSE
  INCOME
  BOTH
}

enum AttachmentStatus {
  PENDING
  READY
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  email                      String               @unique
  passwordHash               String
  displayName                String
  status                     UserStatus           @default(ACTIVE)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  ownedLedgers               Ledger[]             @relation("LedgerOwner")
  memberships                LedgerMembership[]
  createdPlans               Plan[]               @relation("PlanCreator")
  createdExpenses            Expense[]            @relation("ExpenseCreator")
  paidExpenses               Expense[]            @relation("ExpensePayer")
  expenseSplits              ExpenseSplit[]
  settlementsFrom            Settlement[]         @relation("SettlementFrom")
  settlementsTo              Settlement[]         @relation("SettlementTo")
  createdSettlements         Settlement[]         @relation("SettlementCreator")
  createdExpenseSplitOffsets ExpenseSplitOffset[] @relation("OffsetCreator")
  createdCategories          Category[]           @relation("CategoryCreator")
  createdIncomes             Income[]             @relation("IncomeCreator")
  createdExpenseAttachments  ExpenseAttachment[]  @relation("AttachmentCreator")
  activityLogs               ActivityLog[]        @relation("ActivityActor")
  idempotencyRecords         IdempotencyRecord[]
  participations             PlanParticipant[]
  authSessions               AuthSession[]
  createdLedgerInvitations   LedgerInvitation[]   @relation("InvitationCreator")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model Ledger {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  type         LedgerType
  currency     String             @db.VarChar(3)
  ownerId      String             @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime?          @db.Timestamptz(3)
  owner        User               @relation("LedgerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships  LedgerMembership[]
  plans        Plan[]
  invitations  LedgerInvitation[]
  expenses     Expense[]
  settlements  Settlement[]
  categories   Category[]
  incomes      Income[]
  activityLogs ActivityLog[]

  @@index([ownerId])
}

model LedgerMembership {
  id       String     @id @default(uuid()) @db.Uuid
  ledgerId String     @db.Uuid
  userId   String     @db.Uuid
  role     LedgerRole
  joinedAt DateTime   @default(now()) @db.Timestamptz(3)
  leftAt   DateTime?  @db.Timestamptz(3)
  ledger   Ledger     @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  user     User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ledgerId])
  @@index([userId])
}

model LedgerInvitation {
  id           String     @id @default(uuid()) @db.Uuid
  ledgerId     String     @db.Uuid
  createdById  String     @db.Uuid
  tokenHash    String     @unique @db.Char(64)
  invitedEmail String?
  role         LedgerRole @default(MEMBER)
  expiresAt    DateTime   @db.Timestamptz(3)
  acceptedAt   DateTime?  @db.Timestamptz(3)
  revokedAt    DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  ledger       Ledger     @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdBy    User       @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ledgerId])
  @@index([createdById])
  @@index([expiresAt])
}

model Plan {
  id           String            @id @default(uuid()) @db.Uuid
  ledgerId     String            @db.Uuid
  name         String
  description  String?
  startsAt     DateTime?         @db.Timestamptz(3)
  endsAt       DateTime?         @db.Timestamptz(3)
  status       PlanStatus        @default(ACTIVE)
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime?         @db.Timestamptz(3)
  ledger       Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants PlanParticipant[]
  expenses     Expense[]
  settlements  Settlement[]
  incomes      Income[]

  @@index([ledgerId])
  @@index([createdById])
}

model Expense {
  id          String              @id @default(uuid()) @db.Uuid
  ledgerId    String              @db.Uuid
  planId      String?             @db.Uuid
  createdById String              @db.Uuid
  payerId     String              @db.Uuid
  title       String
  description String?
  amountMinor BigInt
  currency    String              @db.VarChar(3)
  splitMethod ExpenseSplitMethod
  isGift      Boolean             @default(false)
  expenseDate DateTime            @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  voidedAt    DateTime?           @db.Timestamptz(3)
  version     Int                 @default(1)
  categoryId  String?             @db.Uuid
  ledger      Ledger              @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  plan        Plan?               @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payer       User                @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments ExpenseAttachment[]

  @@index([ledgerId])
  @@index([planId])
  @@index([createdById])
  @@index([payerId])
  @@index([categoryId])
  @@index([ledgerId, expenseDate])
  @@index([planId, expenseDate])
}

model ExpenseAttachment {
  id               String           @id @default(uuid()) @db.Uuid
  expenseId        String           @db.Uuid
  storageKey       String           @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  status           AttachmentStatus @default(PENDING)
  createdById      String           @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)
  deletedAt        DateTime?        @db.Timestamptz(3)
  expense          Expense          @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("AttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([createdById])
  @@index([expenseId, deletedAt])
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  ledgerId    String       @db.Uuid
  name        String
  kind        CategoryKind
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?    @db.Timestamptz(3)
  ledger      Ledger       @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  expenses    Expense[]
  incomes     Income[]

  @@index([ledgerId])
  @@index([createdById])
}

model Income {
  id          String    @id @default(uuid()) @db.Uuid
  ledgerId    String    @db.Uuid
  planId      String?   @db.Uuid
  createdById String    @db.Uuid
  title       String
  description String?
  amountMinor BigInt
  currency    String    @db.VarChar(3)
  categoryId  String?   @db.Uuid
  incomeDate  DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  voidedAt    DateTime? @db.Timestamptz(3)
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("IncomeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([ledgerId])
  @@index([planId])
  @@index([createdById])
  @@index([categoryId])
  @@index([ledgerId, incomeDate])
  @@index([planId, incomeDate])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  ledgerId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  action      String
  metadata    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  actor       User?    @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ledgerId, createdAt, id])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  operation      String
  key            String
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@index([expiresAt])
}

model ExpenseSplit {
  id             String               @id @default(uuid()) @db.Uuid
  expenseId      String               @db.Uuid
  userId         String               @db.Uuid
  amountMinor    BigInt
  isReimbursable Boolean
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  expense        Expense              @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  offsets        ExpenseSplitOffset[]

  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id          String    @id @default(uuid()) @db.Uuid
  ledgerId    String    @db.Uuid
  planId      String?   @db.Uuid
  fromUserId  String    @db.Uuid
  toUserId    String    @db.Uuid
  amountMinor BigInt
  currency    String    @db.VarChar(3)
  note        String?
  settledAt   DateTime  @db.Timestamptz(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  voidedAt    DateTime? @db.Timestamptz(3)
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  fromUser    User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ledgerId])
  @@index([planId])
  @@index([fromUserId])
  @@index([toUserId])
}

model ExpenseSplitOffset {
  id             String       @id @default(uuid()) @db.Uuid
  expenseSplitId String       @db.Uuid
  amountMinor    BigInt
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?    @db.Timestamptz(3)
  expenseSplit   ExpenseSplit @relation(fields: [expenseSplitId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("OffsetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseSplitId])
  @@index([createdById])
}

model PlanParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  userId    String?  @db.Uuid
  guestName String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([planId, userId])
  @@index([planId])
  @@index([userId])
}

# Single-environment compatibility template. For a shared VPS prefer the
# dedicated .env.dev.example and .env.staging.example templates.
DEFTERDAR_ENVIRONMENT=staging
NODE_ENV=production
PORT=3000
API_HOST=127.0.0.1
API_PORT=3001
API_BODY_LIMIT=1mb

COMPOSE_PROJECT_NAME=defterdar-staging
POSTGRES_DB=defterdar_staging
POSTGRES_USER=defterdar_staging
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_PORT=5432
DATABASE_URL=postgresql://defterdar_staging:replace-with-openssl-rand-hex-32@127.0.0.1:5432/defterdar_staging?schema=public
TEST_DATABASE_URL=postgresql://defterdar_staging:replace-with-openssl-rand-hex-32@127.0.0.1:5432/defterdar_staging?schema=auth_e2e

JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
DEFAULT_CURRENCY=TRY
INVITATION_TTL_DAYS=7
CORS_ORIGINS=https://<YOUR_DOMAIN>

# Self-hosted MinIO: keep these equal to the S3 access/secret pair below.
MINIO_ROOT_USER=defterdar-staging
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-32
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=defterdar-staging-receipts
S3_ACCESS_KEY_ID=defterdar-staging
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_URL_TTL_SECONDS=900
